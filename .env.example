# KIS API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_PROD_CODE=01
# 안전 기본값. 실전 배포에서만 계좌 확인 후 prod로 변경합니다.
KIS_ENV=paper
# KIS Trading MCP(scripts/mcp/kis-trading-mcp.sh)에 실전 키 전달 허용.
# 주문 API까지 노출되므로 기본 미설정=차단. 필요 시에만 1로 지정.
# KIS_MCP_LIVE=1

# Screening data enrichment (선택)
OPENDART_API_KEY=
SEC_USER_AGENT=
FRED_API_KEY=

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
# 운영에서 HTTPS를 강제할 때만 true로 지정, 기본은 요청 프로토콜 기준 자동 판별
# AUTH_COOKIE_SECURE=false

# DB
DATABASE_URL=postgresql://user:password@localhost:5432/kis_trader

# Server
PORT=3000
CLIENT_PORT=3100
# 실전 주문은 롤아웃/복구 확인 후 명시적으로 true로 변경합니다.
TRADING_ENABLED=false

# Slack (선택)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL="#trading-alerts"
SLACK_ENABLED=false
# 승인 가능한 Slack user ID를 쉼표로 구분. 비어 있으면 승인/거절 모두 fail-closed.
SLACK_APPROVER_USER_IDS=

# 토스증권 오픈API (Phase 2 — docs/multi-broker-spec.md D11)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_NO=
